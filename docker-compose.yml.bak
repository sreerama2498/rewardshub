services:
  postgres:
    image: postgres:16
    container_name: rewardshub-postgres

    environment:
      POSTGRES_DB: rewardshub
      POSTGRES_USER: rewarduser
      POSTGRES_PASSWORD: rewardpass

    ports:
      - "5432:5432"

    volumes:
      - postgres_data:/var/lib/postgresql/data

volumes:
  postgres_data:
