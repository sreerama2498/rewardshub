events {}

http {

    upstream frontend {
        server frontend:80;
    }

    upstream backend {
        server backend:8000;
    }

    upstream uptime_kuma {
        server uptime-kuma:3001;
    }

    # -------------------------
    # HTTP -> HTTPS Redirect
    # (catches all domains)
    # -------------------------
    server {
        listen 80 default_server;
        server_name _;
        return 301 https://$host$request_uri;
    }

    # -------------------------
    # RewardsHub HTTPS
    # -------------------------
    server {
        listen 443 ssl;
        server_name rewardshub.sreeram.site;

        ssl_certificate
            /etc/letsencrypt/live/rewardshub.sreeram.site/fullchain.pem;
        ssl_certificate_key
            /etc/letsencrypt/live/rewardshub.sreeram.site/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        # Frontend
        location / {
            proxy_pass http://frontend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Backend API
        location /api/ {
            proxy_pass http://backend/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Swagger
        location /docs {
            proxy_pass http://backend/docs;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location /openapi.json {
            proxy_pass http://backend/openapi.json;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }

    # -------------------------
    # Uptime Kuma HTTPS
    # -------------------------
    server {
        listen 443 ssl;
        server_name status.sreeram.site;

        ssl_certificate
            /etc/letsencrypt/live/status.sreeram.site/fullchain.pem;
        ssl_certificate_key
            /etc/letsencrypt/live/status.sreeram.site/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        location / {
            proxy_pass http://uptime-kuma:3001;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }

}
